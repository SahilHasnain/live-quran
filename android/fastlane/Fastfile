# This file contains the fastlane.tools configuration
# You can find the documentation at https://docs.fastlane.tools
#
# For a list of all available actions, check out
#
#     https://docs.fastlane.tools/actions
#
# For a list of all available plugins, check out
#
#     https://docs.fastlane.tools/plugins/available-plugins
#

# Uncomment the line if you want fastlane to automatically update itself
# update_fastlane

default_platform(:android)

platform :android do
  desc "Runs all the tests"
  lane :test do
    gradle(task: "test")
  end

  desc "Submit a new Beta Build to Crashlytics Beta"
  lane :beta do
    gradle(task: "clean assembleRelease")
    crashlytics
  
    # sh "your_script.sh"
    # You can also use other beta testing services here
  end

  desc "Deploy a new version to the Google Play"
  lane :deploy do |options|
    # Check if we should skip the build (when AAB is already built by Gradle)
    skip_build = ENV["SKIP_ANDROID_BUILD"] == "true"
    
    unless skip_build
      # Build the bundle if not skipped
      gradle(task: "clean bundleRelease")
    end
    
    # Ensure required environment variables are set
    ensure_sentry_token
    ensure_play_store_key
    
    upload_to_play_store(
      track: options[:track] || ENV["PLAY_TRACK"] || "internal",
      aab: options[:aab] || "app/build/outputs/bundle/release/app-release.aab",
      json_key: ENV["SUPPLY_JSON_KEY"] || "/tmp/play-store-key.json",
      skip_upload_apk: true,
      skip_upload_metadata: true,
      skip_upload_images: true,
      skip_upload_screenshots: true
    )
  end
  
  desc "Ensure Sentry token is available"
  lane :ensure_sentry_token do
    if ENV["SENTRY_AUTH_TOKEN"].to_s.empty?
      UI.important("SENTRY_AUTH_TOKEN not set, Sentry upload will be skipped")
    end
  end
  
  desc "Ensure Play Store key is available"
  lane :ensure_play_store_key do
    json_key_path = ENV["SUPPLY_JSON_KEY"] || "/tmp/play-store-key.json"
    unless File.exist?(json_key_path)
      UI.user_error!("Play Store JSON key not found at: #{json_key_path}")
    end
  end
end
