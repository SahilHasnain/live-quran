{"surah_id":114,"surah_name":"An Nas","surah_name_arabic":"اَلنَّاس","surah_name_english":"An Nas","total_verses":6,"translation_name":"Kanzul Irfan (Sindhi)","translation_language":"si","entries_count":7,"entries":[{"ayat_id":29308,"verse_number":0,"verse_key":"114:0","text":"الله جي نالي سان شروع جيڪو نهايت مهربان رحمت وارو آهي"},{"ayat_id":29309,"verse_number":1,"verse_key":"114:1","text":"اوهان فرمايو: مان سمورن ماڻهن جي رب جي پناهه وٺان ٿو."},{"ayat_id":29310,"verse_number":2,"verse_key":"114:2","text":"سمورن ماڻهن جو بادشاهه."},{"ayat_id":29311,"verse_number":3,"verse_key":"114:3","text":"سمورن ماڻهن جو معبود."},{"ayat_id":29312,"verse_number":4,"verse_key":"114:4","text":"باربار وسوسو وجهڻ واري،"},{"ayat_id":29313,"verse_number":5,"verse_key":"114:5","text":"لڪي وڃڻ واري جي شر کان (پناهه وٺان ٿو)[1] جيڪو ماڻهن جي دلين ۾ وسوسو وجهي ٿو."},{"ayat_id":29314,"verse_number":6,"verse_key":"114:6","text":"جنن ۽ انسانن مان."}]}