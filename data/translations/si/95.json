{"surah_id":95,"surah_name":"At Tin","surah_name_arabic":"اَلتِّیْن","surah_name_english":"At Tin","total_verses":8,"translation_name":"Kanzul Irfan (Sindhi)","translation_language":"si","entries_count":9,"entries":[{"ayat_id":29154,"verse_number":0,"verse_key":"95:0","text":"الله جي نالي سان شروع جيڪو نهايت مهربان رحمت وارو آهي"},{"ayat_id":29155,"verse_number":1,"verse_key":"95:1","text":"انجير جو قسم ۽ زيتون جو."},{"ayat_id":29156,"verse_number":2,"verse_key":"95:2","text":"۽ طور سينا جو."},{"ayat_id":29157,"verse_number":3,"verse_key":"95:3","text":"۽ ان امن واري شهر جو."},{"ayat_id":29158,"verse_number":4,"verse_key":"95:4","text":"بيشڪ يقينًا اسان انسان کي سڀ کان سٺي صورت ۾ پيدا ڪيو."},{"ayat_id":29159,"verse_number":5,"verse_key":"95:5","text":"پوءِ ان کي هر هيٺين کان هيٺين حالت ڏانهن ڦيري ڇڏيو[1]."},{"ayat_id":29160,"verse_number":6,"verse_key":"95:6","text":"پر اهي ماڻهو جن ايمان آندو ۽ انهن چڱا ڪم ڪيا ته انهن جي لاءِ بي انتها ثواب آهي."},{"ayat_id":29161,"verse_number":7,"verse_key":"95:7","text":"پوءِ هاڻي ڪهڙي شيء توکي انصاف جي ڪوڙو چوڻ تي اڀاري ٿي."},{"ayat_id":29162,"verse_number":8,"verse_key":"95:8","text":"ڇا الله سڀ حاڪمن کان وڌيڪ حاڪم ناهي[1]."}]}