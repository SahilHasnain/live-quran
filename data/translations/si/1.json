{"surah_id":1,"surah_name":"Al Fatihah","surah_name_arabic":"اَلْفَاتِحَة","surah_name_english":"Al Fatiha","total_verses":7,"translation_name":"Kanzul Irfan (Sindhi)","translation_language":"si","entries_count":8,"entries":[{"ayat_id":23095,"verse_number":0,"verse_key":"1:0","text":"الله جي نالي سان شروع جيڪو نهايت مهربان رحمت وارو آهي۔"},{"ayat_id":23096,"verse_number":1,"verse_key":"1:1","text":"سڀ تعريفون الله جي لاءِ آهن جيڪو سڄي جهان وارن جو پالڻهار آهي۔"},{"ayat_id":23097,"verse_number":2,"verse_key":"1:2","text":"نهايت مهربان رحمت وارو۔"},{"ayat_id":23098,"verse_number":3,"verse_key":"1:3","text":"جزا جي ڏينهن جو مالڪ۔"},{"ayat_id":23099,"verse_number":4,"verse_key":"1:4","text":"اسان تنهنجي ئي عبادت ڪريون ٿا ۽ توکان ئي مدد گهرون ٿا[1]۔"},{"ayat_id":23100,"verse_number":5,"verse_key":"1:5","text":"اسان کي سڌي رستي تي هلاءِ[1]۔"},{"ayat_id":23101,"verse_number":6,"verse_key":"1:6","text":"انهن ماڻهن جو رستو جن تي تو احسان ڪيو۔"},{"ayat_id":23102,"verse_number":7,"verse_key":"1:7","text":"نه انهن جو رستو جن تي غضب ٿيو ۽ نه گمراهن جو[1]."}]}