{"surah_id":112,"surah_name":"Al Ikhlas","surah_name_arabic":"اَلْاِخْلَاص","surah_name_english":"Al Ikhlas","total_verses":4,"translation_name":"Kanzul Irfan (Sindhi)","translation_language":"si","entries_count":5,"entries":[{"ayat_id":29297,"verse_number":0,"verse_key":"112:0","text":"الله جي نالي سان شروع جيڪو نهايت مهربان رحمت وارو آهي"},{"ayat_id":29298,"verse_number":1,"verse_key":"112:1","text":"اوهان فرمايو: اهو الله هڪ آهي[1]."},{"ayat_id":29299,"verse_number":2,"verse_key":"112:2","text":"الله بي نياز آهي."},{"ayat_id":29300,"verse_number":3,"verse_key":"112:3","text":"نه ان ڪنهن کي ڄڻيو ۽ نه اهو ڪنهن مان پيدا ٿيو."},{"ayat_id":29301,"verse_number":4,"verse_key":"112:4","text":"۽ نه وري ان جو ڪو مَٽ آهي."}]}