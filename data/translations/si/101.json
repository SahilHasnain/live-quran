{"surah_id":101,"surah_name":"Al Qariah","surah_name_arabic":"اَلْقَارِعَة","surah_name_english":"Al Qariah","total_verses":11,"translation_name":"Kanzul Irfan (Sindhi)","translation_language":"si","entries_count":12,"entries":[{"ayat_id":29219,"verse_number":0,"verse_key":"101:0","text":"الله جي نالي سان شروع جيڪو نهايت مهربان رحمت وارو آهي"},{"ayat_id":29220,"verse_number":1,"verse_key":"101:1","text":"اها دل ڏڪائڻ واري[1]."},{"ayat_id":29221,"verse_number":2,"verse_key":"101:2","text":"اها دل ڏڪائڻ واري ڇا آهي؟"},{"ayat_id":29222,"verse_number":3,"verse_key":"101:3","text":"۽ توکي ڪهڙي خبر جو اها دل ڏڪائيندڙ ڇا آهي[1]."},{"ayat_id":29223,"verse_number":4,"verse_key":"101:4","text":"جنهن ڏينهن انسان پکڙيل پروانن وانگر هوندا."},{"ayat_id":29224,"verse_number":5,"verse_key":"101:5","text":"۽ جبل رنگ برنگي پڃيل اُنَ وانگر ٿي ويندا."},{"ayat_id":29225,"verse_number":6,"verse_key":"101:6","text":"پوءِ بهرحال جنهن جا پُڙ ڳرا هوندا[1]."},{"ayat_id":29226,"verse_number":7,"verse_key":"101:7","text":"اهو ته پسنديده زندگي ۾ هوندو."},{"ayat_id":29227,"verse_number":8,"verse_key":"101:8","text":"۽ بهرحال جنهن جا پُڙ هلڪا هوندا."},{"ayat_id":29228,"verse_number":9,"verse_key":"101:9","text":"پوءِ ان جو ٺڪاڻو هاويه ٿيندو."},{"ayat_id":29229,"verse_number":10,"verse_key":"101:10","text":"۽ توهان کي ڪهڙي خبر ته اها ڇا آهي؟."},{"ayat_id":29230,"verse_number":11,"verse_key":"101:11","text":"هڪ شعلو هڻندڙ باهه آهي."}]}