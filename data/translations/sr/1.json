{"surah_id":1,"surah_name":"Al Fatihah","surah_name_arabic":"اَلْفَاتِحَة","surah_name_english":"Al Fatiha","total_verses":7,"translation_name":"Kanzul Irfan (Saraiki)","translation_language":"sr","entries_count":8,"entries":[{"ayat_id":72572,"verse_number":0,"verse_key":"1:0","text":"اللہ دے ناں کِنوں شروع جیہڑا ٻَہوں مہربان، رحمت آلا ہِے۔"},{"ayat_id":72573,"verse_number":1,"verse_key":"1:1","text":"سارِیاں تعریفاں اللہ کیتے ہِن جیہڑا سارے جہان آلیاں کوں پالݨ آلا ہِے."},{"ayat_id":72574,"verse_number":2,"verse_key":"1:2","text":"ٻَہوں مہربان رحمت آلا ."},{"ayat_id":72575,"verse_number":3,"verse_key":"1:3","text":"جزا دے ݙینہ دا مالک ."},{"ayat_id":72576,"verse_number":4,"verse_key":"1:4","text":"اساں تیݙی اِی عبادت کریندے ہَیں تے تیݙے کِنوں اِی مدد منگدے ہَیں [1]."},{"ayat_id":72577,"verse_number":5,"verse_key":"1:5","text":"اساکوں سِدھے رستے اُتے ٹُور [1]۔"},{"ayat_id":72578,"verse_number":6,"verse_key":"1:6","text":"اُنہاں لوکاں دا رستہ جنہاں اُتے تَیں احسان کیتا ۔"},{"ayat_id":72579,"verse_number":7,"verse_key":"1:7","text":"نہ جو اُنہاں دا رستہ جنہاں اُتے غضب تھیا تے نہ بھٹکݨ آلیاں دا [1]۔"}]}