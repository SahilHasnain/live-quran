{"surah_id":112,"surah_name":"Al Ikhlas","surah_name_arabic":"اَلْاِخْلَاص","surah_name_english":"Al Ikhlas","total_verses":4,"translation_name":"Kanz-ul-Iman (English)","translation_language":"en","entries_count":5,"entries":[{"ayat_id":6680,"verse_number":0,"verse_key":"112:0","text":"Allah's Name to commence with, the Most Gracious, the Most Merciful."},{"ayat_id":6681,"verse_number":1,"verse_key":"112:1","text":"Say you (O Beloved), 'He is Allah, He is One.'"},{"ayat_id":6682,"verse_number":2,"verse_key":"112:2","text":"'Allah is the Independent.'"},{"ayat_id":6683,"verse_number":3,"verse_key":"112:3","text":"'He has no offspring, nor is He born from anyone.'"},{"ayat_id":6684,"verse_number":4,"verse_key":"112:4","text":"'And there is no one equal to Him.'"}]}