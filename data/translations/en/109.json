{"surah_id":109,"surah_name":"Al Kafirun","surah_name_arabic":"اَلْكَافِرُوْن","surah_name_english":"Al Kafirun","total_verses":6,"translation_name":"Kanz-ul-Iman (English)","translation_language":"en","entries_count":7,"entries":[{"ayat_id":6662,"verse_number":0,"verse_key":"109:0","text":"Allah's Name to commence with, the Most Gracious, the Most Merciful."},{"ayat_id":6663,"verse_number":1,"verse_key":"109:1","text":"Say you (O Beloved), 'O disbelievers!'"},{"ayat_id":6664,"verse_number":2,"verse_key":"109:2","text":"I do not worship whom you worship."},{"ayat_id":6665,"verse_number":3,"verse_key":"109:3","text":"And nor do you worship Whom I worship."},{"ayat_id":6666,"verse_number":4,"verse_key":"109:4","text":"And I shall not worship whom you have worshipped."},{"ayat_id":6667,"verse_number":5,"verse_key":"109:5","text":"Nor will you worship Whom I worship."},{"ayat_id":6668,"verse_number":6,"verse_key":"109:6","text":"For you is your religion, and for me is my religion."}]}